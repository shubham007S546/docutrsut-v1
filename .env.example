ENVIRONMENT=production
CORS_ORIGINS=https://your-production-domain.com

# PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST-NON-POOLING/DBNAME?sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DATABASE=neondb
PGHOST=YOUR_NEON_HOST
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=CHANGE_ME
STORAGE_MODE=postgres

# Auth
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_URL/auth
BETTER_AUTH_SECRET=GENERATE_WITH_openssl_rand_-hex_32
BETTER_AUTH_URL=https://your-production-domain.com

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_CHANGE_ME

# AI Providers
GROQ_API_KEY=gsk_CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=CHANGE_ME
TAVILY_API_KEY=tvly-CHANGE_ME

# AI Gateway
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_MODEL=openai/gpt-4o-mini

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_CHANGE_ME
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
